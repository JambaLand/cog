#!/bin/bash
# Setup TLDV MCP Server in Claude Desktop (macOS)
# This script automates the configuration of TLDV integration in Claude Desktop

set -e

echo "🚀 Setting up TLDV MCP Server for Claude Desktop"
echo "=================================================="
echo ""

# Get the home directory
HOME_DIR="$HOME"
CONFIG_DIR="$HOME_DIR/.config/Claude"
CONFIG_FILE="$CONFIG_DIR/claude_desktop_config.json"

# API Key
TLDV_API_KEY="60baeeba-e74b-405c-ae1f-219fa5b2a691"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Check if Docker is installed
echo "📦 Checking Docker installation..."
if ! command -v docker &> /dev/null; then
    echo -e "${RED}❌ Docker not found. Please install Docker first.${NC}"
    exit 1
fi
echo -e "${GREEN}✅ Docker found${NC}"
echo ""

# Create config directory if it doesn't exist
echo "📁 Ensuring config directory exists..."
mkdir -p "$CONFIG_DIR"
echo -e "${GREEN}✅ Config directory ready: $CONFIG_DIR${NC}"
echo ""

# Check if TLDV MCP image exists, if not build it
echo "🐳 Checking TLDV MCP Docker image..."
if docker image inspect tldv-mcp-server &> /dev/null; then
    echo -e "${GREEN}✅ tldv-mcp-server image already exists${NC}"
else
    echo "⏳ Building TLDV MCP Server Docker image..."
    echo "   This may take a few minutes..."

    # Clone and build
    TEMP_DIR=$(mktemp -d)
    trap "rm -rf $TEMP_DIR" EXIT

    git clone https://gitlab.com/tldv/tldv-mcp-server.git "$TEMP_DIR" 2>/dev/null || {
        echo -e "${RED}❌ Failed to clone TLDV repository${NC}"
        echo "   Try running: git clone https://gitlab.com/tldv/tldv-mcp-server.git"
        exit 1
    }

    cd "$TEMP_DIR"
    docker build -t tldv-mcp-server . || {
        echo -e "${RED}❌ Failed to build Docker image${NC}"
        exit 1
    }
    cd - > /dev/null

    echo -e "${GREEN}✅ Docker image built successfully${NC}"
fi
echo ""

# Handle existing config
if [ -f "$CONFIG_FILE" ]; then
    echo "📋 Found existing Claude Desktop config"

    # Check if TLDV is already configured
    if grep -q '"tldv"' "$CONFIG_FILE"; then
        echo -e "${YELLOW}⚠️  TLDV is already configured in Claude Desktop${NC}"
        read -p "Do you want to update it? (y/n) " -n 1 -r
        echo
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            echo "Skipping configuration update."
            exit 0
        fi

        # Backup existing config
        cp "$CONFIG_FILE" "$CONFIG_FILE.backup"
        echo -e "${GREEN}✅ Backup created: $CONFIG_FILE.backup${NC}"
    fi
else
    echo "Creating new Claude Desktop config..."
fi

echo ""
echo "⚙️  Configuring TLDV in Claude Desktop..."

# Create or update config using Python for JSON safety
python3 << PYTHON
import json
import os
from pathlib import Path

config_file = "$CONFIG_FILE"
config_path = Path(config_file)

# Load existing config or create new one
if config_path.exists():
    with open(config_file, 'r') as f:
        config = json.load(f)
else:
    config = {"mcpServers": {}}

# Ensure mcpServers key exists
if "mcpServers" not in config:
    config["mcpServers"] = {}

# Add or update TLDV configuration
config["mcpServers"]["tldv"] = {
    "command": "docker",
    "args": [
        "run",
        "-i",
        "--init",
        "--rm",
        "-e",
        "TLDV_API_KEY=$TLDV_API_KEY",
        "tldv-mcp-server"
    ]
}

# Write config with nice formatting
with open(config_file, 'w') as f:
    json.dump(config, f, indent=2)

print("✅ Configuration updated successfully")
PYTHON

if [ $? -eq 0 ]; then
    echo -e "${GREEN}✅ Claude Desktop config updated${NC}"
    echo "   Location: $CONFIG_FILE"
else
    echo -e "${RED}❌ Failed to update configuration${NC}"
    exit 1
fi

echo ""
echo -e "${GREEN}✅ Setup complete!${NC}"
echo ""
echo "📋 Next steps:"
echo "   1. Fully close Claude Desktop (not just minimize)"
echo "   2. Reopen Claude Desktop"
echo "   3. You'll now have access to TLDV tools in the chat"
echo ""
echo "🧪 To test:"
echo "   Ask Claude: 'List my TLDV meetings' or 'Get transcript for meeting X'"
echo ""
echo "📚 Available TLDV Tools:"
echo "   • list_meetings - List your TLDV meetings"
echo "   • get_meeting - Get meeting metadata"
echo "   • get_transcript - Get meeting transcript"
echo "   • get_highlights - Get meeting highlights"
echo ""
