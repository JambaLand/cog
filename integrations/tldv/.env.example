# Configuração de Exemplo para Integração TLDV
# Copie este arquivo para .env e preencha com seus dados

# Chave de API do TLDV
# Obtenha em: https://tldv.io/settings/api
TLDV_API_KEY=sua-chave-de-api-aqui

# URL base da API TLDV (opcional, tem um padrão)
# TLDV_API_BASE_URL=https://api.tldv.io/v1

# Timeout para requisições em segundos (padrão: 30)
# TLDV_REQUEST_TIMEOUT=30

# Número máximo de reuniões por requisição (padrão: 50)
# TLDV_MAX_MEETINGS=50

# Chave de API do Composio (opcional)
# Obtenha em: https://platform.composio.dev
# COMPOSIO_API_KEY=sua-chave-composio-aqui
