# Arquivo de Configuração Local (NÃO COMMIT ESTE ARQUIVO!)
#
# Este arquivo é para desenvolvimento local apenas.
# NUNCA commit arquivos .env com credenciais reais.
#
# Como usar:
# 1. Copie este arquivo para .env.local
# 2. Preencha com suas credenciais de desenvolvimento
# 3. Certifique-se de que .env.local está em .gitignore

# Chave de API do TLDV para desenvolvimento local
TLDV_API_KEY=sua-chave-de-desenvolvimento-aqui

# URL base da API (deixe padrão para produção)
# TLDV_API_BASE_URL=https://api.tldv.io/v1

# Timeout para requisições em segundos
# TLDV_REQUEST_TIMEOUT=30

# Número máximo de reuniões por requisição
# TLDV_MAX_MEETINGS=50

# Chave de API do Composio (opcional)
# COMPOSIO_API_KEY=sua-chave-composio-aqui

# Ambiente
# ENV=development
# ENV=production
